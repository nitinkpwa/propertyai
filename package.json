{
  "name": "propertyai",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:build": "opennextjs-cloudflare build",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:size": "node scripts/worker-bundle-report.mjs",
    "analyze:server": "node scripts/analyze-next-server-bundle.mjs",
    "health:full": "node --experimental-strip-types scripts/run-full-health.mjs",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "mobile:audit": "node scripts/mobile-readiness-audit.mjs",
    "db:apply-site-visit": "node scripts/apply-site-visit-schema.mjs",
    "db:check-site-visit": "node scripts/check-site-visit-schema.mjs",
    "db:apply-connect-partners": "node scripts/apply-connect-partners-schema.mjs",
    "db:apply-property-ownership": "node scripts/apply-property-ownership-schema.mjs",
    "db:check-property-ownership": "node scripts/check-property-ownership.mjs",
    "db:check-connect-partners": "node scripts/check-connect-partners-schema.mjs",
    "db:inspect-production": "node scripts/inspect-production-schema.mjs",
    "db:reset-demo-data": "node scripts/reset-demo-data.mjs",
    "icons:generate": "node scripts/generate-favicons.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.106.2",
    "framer-motion": "^12.42.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "pg": "^8.22.0",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "typescript": "^5",
    "wrangler": "^4.114.0"
  }
}
